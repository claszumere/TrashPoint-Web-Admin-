# Supabase client configuration
# Copy this file to .env for local development and fill in your own project values.
# Only use the Supabase anon/public key in Vite frontend variables.
# Never put the Supabase service_role key or other server-only secrets in this file.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Admin role enforcement
# Production should set this to true after admin users have trusted roles in
# Supabase auth app_metadata, for example: { "role": "admin" }.
# Local/dev can temporarily use false to avoid lockout while bootstrapping.
VITE_REQUIRE_ADMIN_ROLE=true
